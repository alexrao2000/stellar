<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.alexr.caltasksync</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/alexr/cal-task-sync/scheduler/run_sync.sh</string>
    </array>

    <!-- Run hourly: captures the pre-noon and nightly updates plus next-morning spillover. -->
    <key>StartInterval</key>
    <integer>3600</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>WorkingDirectory</key>
    <string>/Users/alexr/cal-task-sync</string>

    <key>StandardOutPath</key>
    <string>/Users/alexr/cal-task-sync/logs/sync.out.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/alexr/cal-task-sync/logs/sync.err.log</string>
</dict>
</plist>
