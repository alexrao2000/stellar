# --- Google Tasks ---
# Path to the OAuth client (desktop app) credentials downloaded from Google Cloud.
GOOGLE_CREDENTIALS_FILE=credentials.json
# Where the cached OAuth token is stored after the first consent.
GOOGLE_TOKEN_FILE=token.json
# For headless/CI runs (GitHub Actions), provide these as secrets instead of files.
# They are the full JSON contents of credentials.json and token.json.
GOOGLE_CREDENTIALS_JSON=
GOOGLE_TOKEN_JSON=
# Optional: comma-separated task list names to sync. Empty = all lists.
TASK_LISTS=

# --- Time zone used to bucket tasks into a calendar day ---
# Leave empty to auto-detect this machine's timezone (falls back to UTC).
LOCAL_TIMEZONE=

# --- Storage backend: "sqlite" (zero-setup, local) or "supabase" ---
STORAGE_BACKEND=sqlite

# --- Supabase (required when STORAGE_BACKEND=supabase) ---
SUPABASE_URL=
# Use the service_role key for writes from this local job (keep it secret).
SUPABASE_SERVICE_ROLE_KEY=

# --- SQLite (used when STORAGE_BACKEND=sqlite) ---
SQLITE_PATH=cal_task_sync.sqlite

# --- Metric task titles (match how they appear in Google Tasks) ---
WAKE_UP_TASK_TITLE=Wake Up
WEIGHT_TASK_TITLE=Weigh yourself

# --- Folding hand-recreated task instances into their parent daily task ---
# Deleting one day's instance of a daily task and recreating it by hand yields a
# near-duplicate title, which would otherwise read as a gap in the daily task
# plus a stray one-off. Similar-titled, sparse tasks that fill a gap in a
# established series are folded in automatically.
# Minimum title similarity to fold (0-1). Set to 1 to disable inference entirely
# and rely only on the explicit pins below.
TITLE_FOLD_THRESHOLD=0.86
# Explicit pins, always applied regardless of the threshold.
# Format: Variant=Canonical;Another Variant=Canonical
TITLE_ALIASES=

# The Calendar API does NOT return Google Tasks (only real calendar events), so
# it stays off. Set to true only if you also want calendar events ingested.
INCLUDE_CALENDAR_EVENTS=false
