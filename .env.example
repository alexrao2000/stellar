# --- Google Tasks ---
# Path to the OAuth client (desktop app) credentials downloaded from Google Cloud.
GOOGLE_CREDENTIALS_FILE=credentials.json
# Where the cached OAuth token is stored after the first consent.
GOOGLE_TOKEN_FILE=token.json
# Optional: comma-separated task list names to sync. Empty = all lists.
TASK_LISTS=

# --- Time zone used to bucket tasks into a calendar day ---
LOCAL_TIMEZONE=America/Los_Angeles

# --- Storage backend: "sqlite" (zero-setup, local) or "supabase" ---
STORAGE_BACKEND=sqlite

# --- Supabase (required when STORAGE_BACKEND=supabase) ---
SUPABASE_URL=
# Use the service_role key for writes from this local job (keep it secret).
SUPABASE_SERVICE_ROLE_KEY=

# --- SQLite (used when STORAGE_BACKEND=sqlite) ---
SQLITE_PATH=cal_task_sync.sqlite

# --- Metric task titles (match how they appear in Google Tasks) ---
WAKE_UP_TASK_TITLE=Wake Up
WEIGHT_TASK_TITLE=Weigh yourself
